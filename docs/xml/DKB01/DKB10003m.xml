       江談し遣す、
       <persName corresp="#pers_加藤木">
        <surname>
         加藤木
        </surname>
       </persName>
       来る、書籍類遣す、
       <persName corresp="#pers_阿部祐三">
        <surname>
         阿部
        </surname>
        <forename>
         祐三
        </forename>
       </persName>
